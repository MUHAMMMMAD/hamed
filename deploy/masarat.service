# خدمة systemd لتشغيل MASARAT AI بدون Docker
# انسخها إلى: /etc/systemd/system/masarat.service
# ثم:  sudo systemctl daemon-reload && sudo systemctl enable --now masarat
[Unit]
Description=MASARAT AI Cost Intelligence Platform
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/masarat
EnvironmentFile=-/opt/masarat/.env
ExecStart=/opt/masarat/.venv/bin/uvicorn masarat.api:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
