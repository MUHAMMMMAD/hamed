# ==========================================================================
#  MASARAT AI - مفاتيح نماذج الذكاء الاصطناعي (انسخ هذا الملف إلى .env)
# ==========================================================================
#  النظام يعمل بدون مفاتيح في "الوضع التجريبي" (OFFLINE/MOCK)
#  أضف المفاتيح لتفعيل التحليل الحقيقي من كل نموذج
# ==========================================================================

# ChatGPT  (OpenAI)        -> التحليل والتسعير النهائي
OPENAI_API_KEY=

# Claude   (Anthropic)     -> العقود والمخاطر القانونية
ANTHROPIC_API_KEY=

# Gemini   (Google)        -> المستندات الضخمة والمواصفات
GOOGLE_API_KEY=

# Grok     (xAI)           -> السوق والأسعار اللحظية
XAI_API_KEY=

# Qwen     (Alibaba)       -> التحليل الهندسي والعربية
QWEN_API_KEY=

# Kimi     (Moonshot)      -> الملفات الكبيرة (آلاف الصفحات)
MOONSHOT_API_KEY=

# MiniMax                  -> تشغيل الوكلاء الذكيين
MINIMAX_API_KEY=

# Genspark                 -> البحث الذكي والتقارير
GENSPARK_API_KEY=

# ----- إعدادات عامة -----
# اجبار الوضع التجريبي حتى مع وجود مفاتيح (true/false)
MASARAT_OFFLINE=false
# عدد النماذج التي يُستشار بها في "المجلس" بالتوازي
MASARAT_COUNCIL_TIMEOUT=60
