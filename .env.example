# ==========================================================
#  مسارات التشييد — متغيرات البيئة
# ==========================================================

# مفتاح Anthropic لتشغيل محركات الذكاء الاصطناعي (المساعد، المقدّر، مولّد النطاق، تحليل الصور).
# احصل عليه من: https://console.anthropic.com/settings/keys
# ملاحظة: بدون هذا المفتاح يظل الموقع يعمل بالكامل عبر المحرك الاحتياطي المحلي
# (تقديرات هندسية حسابية + إجابات من قاعدة معرفة الشركة)، لكن بجودة أقل ذكاءً.
ANTHROPIC_API_KEY=

# النموذج المستخدم (اختياري). الافتراضي: claude-opus-5
# بدائل أسرع/أرخص: claude-sonnet-5 أو claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-opus-5

# البريد الذي تصل إليه طلبات عروض الأسعار (اختياري — للربط مستقبلاً بمزود بريد)
CONTACT_INBOX=info@masarat-altashyeed.com
